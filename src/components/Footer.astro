---
import { site } from "../data/site";
---

<footer class="footer wrap mono">
  <p>Designed and built by {site.name}, 2026.</p>
  <p class="colophon">Particles simulated live on your GPU. Set in Mona Sans and Fragment Mono.</p>
  <a class="top" href="#top">Back to top ↑</a>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 8px 24px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .top {
    justify-self: end;
    color: var(--fg);
  }

  .top:hover {
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 860px) {
    .footer {
      grid-template-columns: 1fr;
    }

    .top {
      justify-self: start;
    }
  }
</style>
