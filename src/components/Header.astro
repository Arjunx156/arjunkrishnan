---
import { site } from "../data/site";

const nav = [
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];

// The favicon's dot-matrix A, which re-forms into a K on hover. Upper case = accent dot.
const A = ["...A...", "..#.#..", "..#.#..", ".#...#.", ".#####.", "#.....#", "#.....#"];
const K = [".#...K.", ".#..#..", ".#.#...", ".##....", ".#.#...", ".#..#..", ".#...K."];
const STEP_MS = 28;

const at = (rows: string[], x: number, y: number) => rows[y]?.[x] ?? ".";
const dots = A.flatMap((row, y) =>
  [...row].map((_, x) => {
    const a = at(A, x, y);
    const k = at(K, x, y);
    const cls = [a !== "." && "a", a === "A" && "a-hot", k !== "." && "k", k === "K" && "k-hot"].filter(Boolean);
    return { cx: 2 + x * 2, cy: 2 + y * 2, cls: cls.join(" "), delay: (x + y) * STEP_MS };
  }),
);
---

<header class="header">
  <a class="mark" href="/" aria-label={`${site.shortName}, home`}>
    <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
      {dots.map((d) => <circle cx={d.cx} cy={d.cy} r="0.78" class={d.cls} style={`--d:${d.delay}ms`} />)}
    </svg>
    <span class="word">Arjun<span class="surname"> Krishnan</span></span>
  </a>
  <p class="where mono">{site.city} <span class="time" data-clock></span> IST</p>
  <nav aria-label="Main" class="nav mono">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <button type="button" data-sound aria-pressed="false" hidden>Sound</button>
    <button type="button" data-invert aria-pressed="false">Invert</button>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header);
    padding-inline: var(--gutter);
    background: var(--bg);
  }

  .mark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 620;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .glyph {
    width: 26px;
    height: 26px;
    flex: none;
  }

  /* Each dot fades between the two letters; --d staggers it along the diagonal. */
  .glyph circle {
    fill: var(--dot);
    fill-opacity: 0.09;
    transition:
      fill-opacity 220ms var(--ease) var(--d),
      fill 220ms var(--ease) var(--d);
  }

  .glyph .a {
    fill-opacity: 1;
  }

  .glyph .a-hot {
    fill: var(--accent);
  }

  .mark:hover .glyph circle,
  .mark:focus-visible .glyph circle {
    fill: var(--dot);
    fill-opacity: 0.09;
  }

  .mark:hover .glyph .k,
  .mark:focus-visible .glyph .k {
    fill-opacity: 1;
  }

  .mark:hover .glyph .k-hot,
  .mark:focus-visible .glyph .k-hot {
    fill: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph circle {
      transition: none;
    }
  }

  .where {
    font-variant-numeric: tabular-nums;
  }

  .time {
    display: inline-block;
    min-width: 5ch;
    text-align: center;
  }

  .nav {
    justify-self: end;
    display: flex;
    gap: clamp(14px, 2vw, 28px);
  }

  .nav a,
  .nav button,
  .word {
    padding-block: 6px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 200ms var(--ease);
  }

  .nav a:hover,
  .nav button:hover,
  .mark:hover .word,
  .nav button[aria-pressed="true"] {
    background-size: 100% 1px;
  }

  @media (max-width: 720px) {
    .header {
      grid-template-columns: 1fr auto;
    }

    .where {
      display: none;
    }
  }

  @media (max-width: 440px) {
    .surname {
      display: none;
    }

    .nav {
      gap: 14px;
    }
  }
</style>
