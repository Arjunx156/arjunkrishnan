---
import { SCRIPTS } from "../scripts/hero/glyphs";

const total = String(SCRIPTS.length).padStart(2, "0");
const languages = SCRIPTS.map((s) => s.lang).join(", ");
---

<section class="hero" aria-labelledby="name" data-hero-surface data-scene="name">
  <canvas class="stage" data-hero aria-hidden="true"></canvas>
  <p class="sr-only">
    Behind this text, thousands of particles spell Arjun and re-form it in {SCRIPTS.length} scripts: {languages}.
  </p>

  <div class="marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <div class="hud">
    <p class="now mono" aria-live="off">
      <span class="index"><span data-index>01</span>/{total}</span>
      <span data-lang>English</span>
      <span class="native" data-native>Arjun</span>
    </p>
    <ol class="ticks" aria-hidden="true">
      {SCRIPTS.map((s, i) => <li data-tick class={i === 0 ? "on" : ""} title={s.lang} />)}
    </ol>
    <div class="controls mono">
      <button type="button" data-next>Next script</button>
      <button type="button" data-pause aria-pressed="false">Pause</button>
    </div>
  </div>

  <div class="foot">
    <div class="who">
      <h1 id="name" class="name">Arjun Krishnan Suresh</h1>
      <p class="role">AI engineer and researcher</p>
    </div>
    <div class="say">
      <p class="tagline">I build AI systems and don't call them done until the numbers agree.</p>
      <p class="stats mono" aria-hidden="true">
        <span data-particles>-</span> particles, <span data-fps>-</span> fps. Move to scatter, click to speak.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    max-height: 1400px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: calc(var(--header) + 16px) var(--gutter) clamp(20px, 3vw, 40px);
    cursor: crosshair;
  }

  .stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Registration marks: the stage is an instrument, not a backdrop. */
  .marks {
    position: absolute;
    inset: calc(var(--header) + 4px) calc(var(--gutter) - 10px) 10px;
    pointer-events: none;
  }

  .marks i {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--muted);
    border-style: solid;
    border-width: 0;
    opacity: 0.7;
  }

  .marks i:nth-child(1) {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .marks i:nth-child(2) {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .marks i:nth-child(3) {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .marks i:nth-child(4) {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .hud,
  .foot {
    position: relative;
  }

  .hud {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .now {
    display: flex;
    align-items: baseline;
    gap: 14px;
    white-space: nowrap;
  }

  .index {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .index span {
    color: var(--accent);
  }

  /* The name fonts are registered by the hero script; until then the system fills in. */
  .native {
    font-family:
      var(--sans), "Name Malayalam", "Name Devanagari", "Name Tamil", "Name Telugu", "Name Kannada", "Name Bengali",
      "Name Gujarati", "Name Gurmukhi", sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .ticks {
    display: flex;
    gap: 6px;
  }

  .ticks li {
    width: 18px;
    height: 2px;
    background: var(--line);
    transition: background-color 320ms var(--ease);
  }

  .ticks li.done {
    background: var(--muted);
  }

  .ticks li.on {
    background: var(--accent);
  }

  .controls {
    justify-self: end;
    display: flex;
    gap: 8px;
  }

  .controls button {
    padding: 6px 12px;
    white-space: nowrap;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    transition:
      background-color var(--fast) var(--ease),
      color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }

  .controls button:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .controls button:active {
    transform: translateY(1px);
  }

  .controls button[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .foot {
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .who {
    grid-column: 1 / span 7;
  }

  .name {
    font-size: clamp(40px, 5.2vw, 96px);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin-left: -0.03em;
  }

  .role {
    margin-top: 10px;
    font-size: clamp(17px, 1.5vw, 24px);
    font-weight: 300;
    font-stretch: 125%;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .say {
    grid-column: 9 / -1;
  }

  .tagline {
    max-width: 26ch;
    font-size: clamp(18px, 1.4vw, 23px);
    line-height: 1.34;
    text-wrap: pretty;
  }

  .stats {
    margin-top: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 960px) {
    .hud {
      grid-template-columns: 1fr auto;
    }

    .ticks {
      display: none;
    }

    .who,
    .say {
      grid-column: 1 / -1;
    }

    .say {
      margin-top: 20px;
    }
  }

  @media (max-width: 520px) {
    .native {
      display: none;
    }

    .controls button {
      padding: 6px 9px;
    }
  }
</style>
