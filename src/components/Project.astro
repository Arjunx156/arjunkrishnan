---
import type { Project } from "../data/work";

interface Props {
  project: Project;
  number: number;
}

const { project: p, number } = Astro.props;
---

<article class="project" data-project aria-labelledby={`${p.id}-title`}>
  <div class="copy">
    <p class="meta mono"><span>{p.kind}</span><span>{p.year}</span></p>
    <h3 id={`${p.id}-title`} class="title" data-reveal>{p.title}</h3>
    <p class="lede">{p.lede}</p>
    <p class="body">{p.body}</p>

    <dl class="metrics">
      {
        p.metrics.map((m) => (
          <div>
            <dt class="mono">{m.label}</dt>
            <dd data-count>{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="stack mono"><span class="sr-only">Built with </span>{p.stack.join(" / ")}</p>

    {
      p.links.length > 0 && (
        <ul class="links">
          {p.links.map((l) => (
            <li>
              <a class="link" href={l.href} rel="noopener" target="_blank">
                {l.label}
                <span class="sr-only"> for {p.title} (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <figure class="plate" data-wipe>
    <div class="frame">
      <canvas data-figure={p.figure} role="img" aria-label={p.figureAlt}></canvas>
    </div>
    <figcaption class="mono">
      <span class="fig">Fig. {number}</span>
      <span class="cap">{p.caption}</span>
      <button type="button" class="toggle" data-figure-pause aria-pressed="false" aria-label={`Pause figure ${number}`}>
        Pause
      </button>
    </figcaption>
  </figure>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 32px;
    padding-block: clamp(48px, 7vw, 112px);
    border-top: 1px solid var(--line);
  }

  .copy {
    grid-column: 1 / span 5;
  }

  .plate {
    grid-column: 7 / -1;
    position: sticky;
    top: calc(var(--header) + 24px);
    align-self: start;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
  }

  .title {
    margin-top: 20px;
    font-size: clamp(36px, 4.3vw, 72px);
    font-weight: 680;
    font-stretch: 82%;
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 28px;
    font-size: clamp(19px, 1.45vw, 24px);
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .body {
    margin-top: 16px;
    max-width: 62ch;
    color: var(--muted);
    text-wrap: pretty;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }

  .metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 4px;
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
  }

  dd {
    font-size: clamp(30px, 2.6vw, 44px);
    font-weight: 700;
    font-stretch: 75%;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  dt {
    color: var(--muted);
  }

  .stack {
    margin-top: 24px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 24px;
    font-weight: 560;
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--line);
  }

  canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-top: 12px;
    color: var(--muted);
  }

  .fig {
    flex: none;
    color: var(--fg);
  }

  .cap {
    flex: 1;
  }

  .toggle {
    flex: none;
    padding: 2px 8px;
    border: 1px solid var(--line);
    color: var(--muted);
    transition:
      background-color var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .toggle:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .toggle[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 960px) {
    .copy,
    .plate {
      grid-column: 1 / -1;
    }

    .plate {
      position: static;
      grid-row: 1;
    }
  }
</style>
