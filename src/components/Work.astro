---
import { chapters, notes } from "../data/work";
import Project from "./Project.astro";

const pad = (n: number) => String(n).padStart(2, "0");
const numbered = chapters.map((c, i) => ({
  ...c,
  start: chapters.slice(0, i).reduce((n, prev) => n + prev.projects.length, 1),
}));
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="head wrap mono">
    <h2 id="work-title">Selected work</h2>
    <p>{chapters.length} chapters, 2025 to now</p>
  </div>

  {
    numbered.map((c, ci) => (
      <section class="chapter" aria-labelledby={`${c.id}-title`}>
        <header class="card wrap" data-scene={c.scene}>
          <p class="kicker mono">
            Chapter <span class="n">{pad(ci + 1)}</span> / {pad(chapters.length)}
          </p>
          <h2 id={`${c.id}-title`} class="chapter-title" data-reveal>
            {c.title}
          </h2>
          <p class="chapter-note">{c.note}</p>
          <ol class="toc mono">
            {c.projects.map((p, i) => (
              <li>
                <span class="fig">Fig. {c.start + i}</span>
                <a href={`#${p.id}-title`}>{p.title}</a>
              </li>
            ))}
          </ol>
          <p class="scene-note mono" aria-hidden="true">
            {c.sceneNote}
          </p>
        </header>
        <div class="projects wrap" data-scene="dust">
          {c.projects.map((p, i) => (
            <Project project={p} number={c.start + i} />
          ))}
        </div>
      </section>
    ))
  }

  <section class="notes wrap" aria-labelledby="notes-title" data-scene="dust">
    <header class="notes-head">
      <h2 id="notes-title" class="notes-title" data-reveal>Also built</h2>
      <p class="notes-note">Smaller, sharper things. Each one taught me something the big ones needed.</p>
    </header>
    <ul>
      {
        notes.map((n) => (
          <li class="note">
            <h3>{n.title}</h3>
            <p class="line">{n.line}</p>
            <p class="year mono">{n.year}</p>
            <p class="note-links">
              {n.links.map((l) => (
                <a class="link" href={l.href} rel="noopener" target="_blank">
                  {l.label}
                  <span class="sr-only"> for {n.title} (opens in a new tab)</span>
                </a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</section>

<style>
  .work {
    padding-bottom: var(--section);
  }

  .head {
    display: flex;
    justify-content: space-between;
    padding-block: 16px;
    color: var(--muted);
  }

  .head h2 {
    font: inherit;
    color: var(--fg);
  }

  .head {
    position: relative;
    background-image: linear-gradient(var(--fg), var(--fg));
    background-size: calc(100% - 2 * var(--gutter)) 1px;
    background-position: var(--gutter) 0;
    background-repeat: no-repeat;
  }

  /* Chapter title card: a full screen of type on the left, the particle scene on the right. */
  .card {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 28px;
    padding-block: 120px;
  }

  .kicker {
    color: var(--muted);
  }

  .kicker .n {
    color: var(--accent);
  }

  .chapter-title {
    font-size: clamp(72px, 13vw, 240px);
    font-weight: 300;
    font-stretch: 125%;
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin-left: -0.06em;
    max-width: 8ch;
  }

  .chapter-note {
    max-width: 30ch;
    font-size: clamp(20px, 1.6vw, 26px);
    line-height: 1.3;
  }

  .toc {
    display: grid;
    gap: 8px;
    max-width: 34rem;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .toc li {
    display: flex;
    gap: 16px;
  }

  .toc .fig {
    color: var(--muted);
    min-width: 4.5em;
  }

  .toc a {
    color: var(--fg);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 240ms var(--ease);
  }

  .toc a:hover {
    background-size: 100% 1px;
  }

  .scene-note {
    max-width: 34rem;
    color: var(--muted);
  }

  .notes {
    padding-top: clamp(80px, 10vw, 160px);
  }

  .notes-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  .notes-title {
    grid-column: 1 / span 7;
    font-size: clamp(48px, 8.4vw, 148px);
    font-weight: 300;
    font-stretch: 125%;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-left: -0.05em;
  }

  .notes-note {
    grid-column: 9 / -1;
    max-width: 34ch;
    color: var(--muted);
    padding-bottom: 0.4em;
  }

  .note {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 8px;
    align-items: baseline;
    padding: 24px 12px;
    margin-inline: -12px;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    transition:
      background-color var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .note:last-child {
    border-bottom: 1px solid var(--line);
  }

  .note h3 {
    grid-column: 1 / span 4;
    font-size: clamp(20px, 1.6vw, 26px);
    font-weight: 640;
    font-stretch: 90%;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .line {
    grid-column: 5 / span 5;
    color: var(--muted);
  }

  .year {
    grid-column: 10 / span 1;
    color: var(--muted);
  }

  .note-links {
    grid-column: 11 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    justify-content: end;
    font-weight: 560;
  }

  /* The whole row inverts: hover and focus are the only accents the layout itself uses. */
  @media (hover: hover) {
    .note:hover,
    .note:focus-within {
      background: var(--fg);
      color: var(--bg);
    }

    .note:hover .line,
    .note:hover .year,
    .note:focus-within .line,
    .note:focus-within .year {
      color: var(--bg);
    }

    .note:focus-within :focus-visible {
      outline-color: var(--bg);
    }

    .note:hover .link:hover {
      background: var(--bg);
      color: var(--fg);
    }
  }

  @media (max-width: 960px) {
    .card {
      align-content: end;
      padding-bottom: 80px;
    }

    .notes-title,
    .notes-note {
      grid-column: 1 / -1;
    }

    .notes-note {
      margin-top: 16px;
    }

    .note h3,
    .line {
      grid-column: 1 / -1;
    }

    .year {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .note h3 {
      grid-row: 2;
    }

    .note-links {
      grid-column: 1 / -1;
      justify-content: start;
    }
  }
</style>
